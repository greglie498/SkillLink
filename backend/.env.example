# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/skilllink?schema=public"

# Secret used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# URL the frontend runs on (used for CORS)
FRONTEND_ORIGIN="http://localhost:5173"

# Port the API listens on
PORT=4000

# Auth
AUTH_RATE_LIMIT = 20 # Max auth request per IP